6. VIEW POINTS ACTIVITY DIAGRAM
================================================================================

@startuml ViewPoints
title View Points - Simplified

|User|
start
:Buka Halaman Poin;

|System|
:Fetch Balance & Statistik;
:Tampilkan Total Poin & Botol;

|User|
if (Aksi?) then (Lihat Riwayat)
  :Redirect ke Riwayat;
  stop
else if (Redeem)
  :Redirect ke Redeem;
  stop
else (Tutup)
  stop
endif

@enduml

================================================================================

7. VIEW TRANSACTION HISTORY ACTIVITY DIAGRAM
================================================================================

@startuml ViewHistory
title View Transaction History - Simplified

|User|
start
:Buka Halaman Riwayat;

|System|
:Fetch Transaksi (Pagination);
:Tampilkan Statistik (Total Poin, Total Tarik Saldo, Total Botol);

if (Ada Data?) then (Ya)
  :Tampilkan Daftar Transaksi;
  
  |User|
  if (Ada Pending Claim?) then (Ya)
    :Klik "Ambil Poin";
    |System|
    :Proses Claim Points;
    :Update Balance;
    :Refresh Daftar;
    |User|
    stop
  else (Tidak)
    :Lihat Riwayat;
    stop
  endif
  
else (Tidak)
  |User|
  :Tampilkan "Belum Ada Aktivitas";
  stop
endif

@enduml

================================================================================

8. REDEEM REWARD ACTIVITY DIAGRAM
================================================================================

@startuml RedeemReward
title Redeem Reward - Simplified

|User|
start
:Buka Halaman Redeem;

|System|
if (Poin\nCukup?) then (Ya)
  :Tampilkan Pilihan Redeem;
  
  |User|
  :Pilih Reward & Konfirmasi;
  
  |System|
  :Proses Redeem;
  
  |Payment|
  :Process Payment;
  
  if (Berhasil?) then (Ya)
    |System|
    :Update Status;
    |User|
    :Tampilkan Receipt;
    stop
  else (Gagal)
    |User|
    :Tampilkan Error;
    stop
  endif
  
else (Tidak)
  |User|
  :Tampilkan "Poin Tidak Cukup";
  stop
endif

@enduml

================================================================================

9. DEPOSIT BOTTLES ACTIVITY DIAGRAM
================================================================================

@startuml DepositBottles
title Deposit Bottles - Simplified

|User|
start
:Scan QR Code;

|System|
if (QR\nValid?) then (Ya)
  |User|
  repeat
    :Masukkan Botol;
    |Arduino|
    :Deteksi Botol;
    |System|
    :Hitung Botol;
    :Hitung Point;
    |User|
    :Lihat Update;
  repeat while (Lanjut?) is (Ya)
  
  :Claim Point;
  
  |System|
  :Update Balance;
  
  |User|
  :Tampilkan Receipt;
else (Tidak)
  |User|
  :Error;
endif

stop
@enduml

