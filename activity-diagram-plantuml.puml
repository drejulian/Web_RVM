Activity Diagrams - RVM Application (Simplified PlantUML)
=======================================================

File ini berisi 9 activity diagrams SEDERHANA dalam format PlantUML.
Fokus pada alur utama dengan swimlanes yang bersih dan mudah dipahami.

================================================================================

1. LOGIN ACTIVITY DIAGRAM
================================================================================

@startuml Login
title Login - Simplified

|User|
start
:Buka Halaman Login;

if (Metode\nLogin?) then (Email/Password)
  :Input Email & Password;
  :Click Login;
  
  |System|
  if (Validasi\nLogin?) then (Berhasil)
    :Login Berhasil;
    |User|
    :Redirect ke Home;
    stop
  else (Gagal)
    |User|
    :Tampilkan Error;
    stop
  endif

else (Google OAuth)
  |Google OAuth|
  :Google Authentication;
  
  if (Berhasil?) then (Ya)
    |System|
    :Login Berhasil;
    |User|
    :Redirect ke Home;
    stop
  else (Tidak)
    |User|
    :Tampilkan Error;
    stop
  endif
endif

@enduml

================================================================================

2. REGISTER ACTIVITY DIAGRAM
================================================================================

@startuml Register
title Register - Simplified

|User|
start
:Buka Halaman Register;
:Isi Form (Nama, Email, Password);
:Accept Terms;
:Click Register;

|System|
if (Validasi\nData?) then (OK)
  :Simpan User;
  :Registrasi Berhasil;
  |User|
  :Redirect ke Home;
  stop
else (Error)
  |User|
  :Tampilkan Error;
  stop
endif

@enduml

================================================================================

3. MANAGE PROFILE ACTIVITY DIAGRAM
================================================================================

@startuml ManageProfile
title Manage Profile - Simplified

|User|
start
:Buka Halaman Profil;

|System|
:Tampilkan Data Profil;

|User|
if (Edit\nProfil?) then (Ya)
  :Ubah Data;
  :Click Simpan Perubahan;
  
  |System|
  :Validasi Data;
  :Simpan Perubahan;
  
  |User|
  :Lihat Notifikasi Sukses;
  stop
  
else (Tidak)
  if (Ganti\nPassword?) then (Ya)
    :Input Password Baru;
    :Click Simpan Password;
    
    |System|
    :Simpan Password Baru;
    :Logout;
    
    |User|
    :Redirect ke Halaman Login;
    stop
    
  else (Tidak)
    if (Logout?) then (Ya)
      |System|
      :Logout;
      
      |User|
      :Redirect ke Halaman Login;
      stop
    else (Tidak)
      stop
    endif
  endif
endif

@enduml

================================================================================

4. VIEW RVM LOCATION ACTIVITY DIAGRAM
================================================================================

@startuml ViewLocation
title View RVM Location - Simplified

|User|
start
:Buka Halaman Lokasi RVM;

|System|
if (Izin\nLokasi?) then (Ya)
  :Ambil Lokasi User;
else (Tidak)
  :Gunakan Lokasi Default;
endif

|Leaflet|
:Tampilkan Peta;
:Tampilkan Marker RVM;

|User|
if (Klik\nMarker?) then (Ya)
  |System|
  :Tampilkan Detail RVM;
  
  |User|
  if (Petunjuk\nArah?) then (Ya)
    |Google Maps|
    :Navigasi ke Lokasi;
    
    |User|
    :Lihat Rute;
  endif
endif

stop
@enduml

